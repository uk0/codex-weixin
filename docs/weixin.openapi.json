    "/ilink/bot/get_bot_qrcode": {
      "post": {
        "summary": "Request login QR code",
        "responses": {
          "200": {
            "description": "Client protocol snapshot; not a verified exhaustive server contract.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "qrcode": {
                      "type": "string"
                    },
                    "qrcode_img_content": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "qrcode": "test-qr",
                  "qrcode_img_content": "https://example.invalid/weixin-qr"
                }
              }
            }
          },
          "429": {
            "description": "HTTP rate limit"
          },
          "500": {
            "description": "Upstream HTTP failure"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "local_token_list": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "local_token_list"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "bot_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "3"
          }
        ]
      }
    },
